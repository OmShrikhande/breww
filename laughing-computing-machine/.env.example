# Admin database (root API — /api)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=games_db
DB_USER=postgres
DB_PASSWORD=Mysql@2026

# Production admin DB (optional; used instead of DB_* when set)
# DATABASE_URL=postgresql://user:pass@host:5432/games_db

# Admin JWT — must be at least 32 random characters
JWT_SECRET=change_me_to_a_random_64_char_secret_string_here_do_not_use_this

# Public port (admin + player share this on one deploy)
PORT=3000

# CORS — admin UI + player UI
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Brute-force lockout (admin)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
API_RATE_LIMIT=60

# Optional: override player settings from root (otherwise backend/.env is used)
# PLAYER_DATABASE_URL=postgresql://...
# PLAYER_JWT_SECRET=...
# PLAYER_JWT_EXPIRES_IN=24h
# PLAYER_ENGINE_API_BASE_URL=http://localhost:8000/api
# PLAYER_ENGINE_INTERNAL_API_KEY=
