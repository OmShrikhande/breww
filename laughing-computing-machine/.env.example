# ─── Single env file — admin (/api) + player (/player/api) ───

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=games_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Production (optional; overrides DB_* above when set)
# DATABASE_URL=postgresql://user:pass@host:5432/games_db

# Admin JWT — must be at least 32 random characters
JWT_SECRET=change_me_to_a_random_64_char_secret_string_here_do_not_use_this

# Player JWT (optional overrides)
# PLAYER_JWT_SECRET=
# PLAYER_JWT_EXPIRES_IN=24h

PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
API_RATE_LIMIT=60

# Player API
SEED_BALANCE=10000
# ENGINE_API_BASE_URL=http://localhost:8000/api
# ENGINE_INTERNAL_API_KEY=
