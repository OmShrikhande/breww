PORT=3001

# Player Postgres (Render or local)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=24h

# Optional game engine proxy
ENGINE_API_BASE_URL=http://localhost:8000/api
ENGINE_INTERNAL_API_KEY=

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Optional overrides when mounted under root index.js (else backend/.env is used)
# PLAYER_DATABASE_URL=
# PLAYER_JWT_SECRET=
# PLAYER_JWT_EXPIRES_IN=24h
# ENGINE_API_BASE_URL=http://localhost:8000/api
# ENGINE_INTERNAL_API_KEY=
